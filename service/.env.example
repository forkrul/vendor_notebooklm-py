# --- REQUIRED ---
# Bearer token clients must present in the Authorization header.
# Generate one with:  python -m service.auth   (or)   openssl rand -hex 32
API_TOKEN=replace-me-with-a-long-random-string

# --- OPTIONAL ---
# Override the host directory containing storage_state.json.
# Defaults to ~/.notebooklm on the host.
# NOTEBOOKLM_HOST_DIR=/home/you/.notebooklm

# Service version reported in OpenAPI metadata.
# SERVICE_VERSION=0.1.0
